# ─── Supabase ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ─── OAuth Providers (configure in Supabase Dashboard → Authentication → Providers)
# Google OAuth
# 1. Create credentials at: https://console.cloud.google.com/apis/credentials
# 2. Add Client ID + Secret in Supabase → Auth → Providers → Google
# 3. Set redirect URI: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
EXPO_PUBLIC_GOOGLE_OAUTH_ENABLED=true

# Facebook OAuth
# 1. Create app at: https://developers.facebook.com
# 2. Add App ID + Secret in Supabase → Auth → Providers → Facebook
# 3. Set redirect URI: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
EXPO_PUBLIC_FACEBOOK_OAUTH_ENABLED=true

# ─── App Config ───────────────────────────────────────────────────────────────
# Deep link scheme (must match app.json "scheme" field)
EXPO_PUBLIC_APP_SCHEME=focable

# ─── EAS Build (used by eas.json, do NOT prefix with EXPO_PUBLIC_) ────────────
# Get from: https://expo.dev → Account → Access Tokens
EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID
